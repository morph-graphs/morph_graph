{
  "media": {
    "enabled": true,
    "mode": "evidence",
    "source": "evclips",
    "max_side": 448,
    "encode_fps": null,
    "audio": false
  },
  "model": {
    "backend": "openai",
    "name": "gpt-5.1",
    "api_key_env": "OPENAI_API_KEY",
    "reasoning_summary": null,
    "max_output_tokens": 32768,
    "max_frames": 384,
    "max_fps": 1.0,
    "frame_side": 512,
    "detail": "high",
    "jpeg_quality": 3,
    "frame_timestamps": false,
    "max_retries": 6,
    "timeout_s": 1800
  },
  "runtime": {
    "max_concurrent_groups": 2,
    "max_concurrent_requests": 4,
    "prep_workers": 4,
    "retry_truncated": false
  }
}
