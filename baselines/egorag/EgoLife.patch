+def _log_usage(call, response, endpoint=None):
+    """EPIC-Morph port: append the model id the API returned and the token usage of one call to the JSON-lines
+    file named by EGORAG_USAGE_LOG (run_egorag.sh sums it into runs.jsonl), with the endpoint asked and, through
+    OpenRouter, the provider that served the call and the dollars charged. Never the prompt, never a key.
+    Takes a client's response object or a response dict; never raises (a logging problem must not make the
+    caller retry a call that was already paid for)."""
+    try:
+        path = os.getenv("EGORAG_USAGE_LOG")
+        if not path:
+            return
+        import json
+        at = lambda o, k: None if o is None else o.get(k) if hasattr(o, "get") else getattr(o, k, None)
+        extra = lambda o: getattr(o, "model_extra", None) or {}   # what OpenRouter adds to a reply
+        usage = at(response, "usage")
+        with open(path, "a") as f:
+            f.write(json.dumps({"t": time.time(), "call": call, "model": at(response, "model"),
+                                "prompt_tokens": at(usage, "prompt_tokens"), "completion_tokens": at(usage, "completion_tokens"),
+                                "cached_tokens": at(at(usage, "prompt_tokens_details"), "cached_tokens"),
+                                "reasoning_tokens": at(at(usage, "completion_tokens_details"), "reasoning_tokens"),
+                                "finish_reason": at((at(response, "choices") or [None])[0], "finish_reason"),
+                                "endpoint": endpoint, "provider": extra(response).get("provider"),
+                                "cost": extra(usage).get("cost")}) + "\n")
+    except Exception as e:
+        print(f"usage log failed: {e}")
+
+
+# EPIC-Morph port, the gateway: with OPENROUTER_API_KEY set and a provider's own key not (nor upstream's Azure
+# variables for it), that provider's calls go through OpenRouter, pinned to the provider itself with no fallback
+# (OpenRouter also lists Azure for gpt-4o and other hosts for DeepSeek's models): it answers or the call fails.
+# The request is otherwise the one the provider's own API gets. OpenRouter's id of what each name is at its
+# provider: deepseek-v4-pro is DeepSeek-V4-Pro-0813 on DeepSeek's API (its pricing page, read 2026-11-14), the
+# only V4 Pro that DeepSeek itself serves on OpenRouter (deepseek/deepseek-v4-pro there is the 0423 version, on
+# other hosts). A name not listed is sent as it is.
+_ROUTER_URL = os.getenv("OPENROUTER_BASE_URL") or "https://openrouter.ai/api/v1"
+_ROUTER_IDS = {"gpt-4o": "openai/gpt-4o", "gpt-4.1": "openai/gpt-4.1", "deepseek-v4-pro": "deepseek/deepseek-v4-pro-0813"}
+
+
+def _client(own_key, own_url, model, provider):
+    """(client, model id, extra_body) of a plain-key call: the provider's own API with its key, else OpenRouter."""
+    if own_key:
+        return OpenAI(api_key=own_key, base_url=own_url), model, None
+    return (OpenAI(api_key=os.environ["OPENROUTER_API_KEY"], base_url=_ROUTER_URL), _ROUTER_IDS.get(model, model),
+            {"provider": {"only": [provider], "allow_fallbacks": False}})
+
+
+# EPIC-Morph port: per function, why its last call gave up (endpoint, model, the API's own message). Upstream turns a
+# failed call into the text "error" (call_gpt4) or None (call_deepseek) and goes on, so the reason is only in the
+# per-attempt prints; epic/build_memory.py ends a failed build with it.
+LAST_ERROR = {}
+
+
+class EmptyReply(Exception):
+    """EPIC-Morph port: a 200 reply with no text. A reasoning model (DeepSeek-V4-Pro) that spends max_tokens on its
+    reasoning answers with empty content and finish_reason "length". Upstream keeps "" as an answer and drops that
+    window or hour from the summaries without a word; raised, it is retried and recorded in LAST_ERROR like an API error."""
+
+
+def _text(response, text=None):
+    """The reply's text (or `text`, what is left of it after upstream's </think> split), else EmptyReply saying why."""
+    choice = response.choices[0]
+    text = choice.message.content if text is None else text
+    if text and text.strip():
+        return text
+    reasoning = (getattr(choice.message, "model_extra", None) or {})
+    reasoning = reasoning.get("reasoning_content") or reasoning.get("reasoning") or ""
+    details = getattr(response.usage, "completion_tokens_details", None)
+    raise EmptyReply(f"empty content (finish_reason={choice.finish_reason}, completion_tokens="
+                     f"{getattr(response.usage, 'completion_tokens', None)}, reasoning_tokens={getattr(details, 'reasoning_tokens', None)}, "
+                     f"reasoning {len(reasoning)} chars) from {response.model}")
+
+
