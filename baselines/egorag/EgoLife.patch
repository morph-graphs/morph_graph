+def _log_usage(call, response):
+    """EPIC-Morph port: append the model id the API returned and the token usage of one call to the JSON-lines
+    file named by EGORAG_USAGE_LOG (run_egorag.sh sums it into runs.jsonl). Never the prompt, never a key.
+    Takes a client's response object or a response dict; never raises (a logging problem must not make the
+    caller retry a call that was already paid for)."""
+    try:
+        path = os.getenv("EGORAG_USAGE_LOG")
+        if not path:
+            return
+        import json
+        get = (lambda o, k: o.get(k)) if isinstance(response, dict) or hasattr(response, "keys") else (lambda o, k: getattr(o, k, None))
+        usage = get(response, "usage") or {}
+        get_u = (lambda k: usage.get(k)) if hasattr(usage, "get") else (lambda k: getattr(usage, k, None))
+        with open(path, "a") as f:
+            f.write(json.dumps({"t": time.time(), "call": call, "model": get(response, "model"),
+                                "prompt_tokens": get_u("prompt_tokens"), "completion_tokens": get_u("completion_tokens")}) + "\n")
+    except Exception as e:
+        print(f"usage log failed: {e}")
+
+
