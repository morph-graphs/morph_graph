# MERIT environment image for aarch64 hosts (Grace CPUs: GH200, GB200, GB300), one per arm like Dockerfile (x86).
# The same pinned packages as the x86 image (env/requirements-<arm>.txt, transformers 4.57.3 / 5.8.0) over a
# different stack, because torch 2.6 has no aarch64 CUDA wheels and CUDA 12.4 does not know Blackwell:
#   Python 3.11 (deadsnakes, /opt/py), torch 2.8.0 + torchvision 0.23.0 for CUDA 12.9, flash-attn 2.7.4.post1 and
#   decord 0.6.0 compiled (baselines/common/docker/arm64_stack.sh), causal-conv1d 1.6.1 compiled by
#   env/install_requirements.sh as on x86 (with CUDA 12.9 it adds sm_100 and sm_120 kernels).
# Tag ghcr.io/morph-graphs/merit:<arm>-arm64-<hash> (IMAGE_ARCH=arm64 bash docker/image_tag.sh <arm>).
#
#   docker build -f baselines/merit/docker/Dockerfile.arm64 --build-arg ARM=m8 -t merit:m8-arm64 .   (morph_graph root)
#   (IMAGE_ARCH=arm64 bash baselines/merit/docker/build.sh m8 does this with the published tag)
FROM nvidia/cuda:12.9.1-devel-ubuntu22.04

# the shared stack first, identical in every baseline's arm64 image (one compile of flash-attn per machine)
ARG MAX_JOBS=3
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 TOKENIZERS_PARALLELISM=false \
    PATH=/opt/py/bin:$PATH PY=/opt/py/bin/python HOME=/tmp TRITON_CACHE_DIR=/tmp/triton HF_HOME=/hf CUDA_HOME=/usr/local/cuda
COPY baselines/common/docker/arm64_stack.sh /tmp/arm64_stack.sh
RUN MAX_JOBS=$MAX_JOBS bash /tmp/arm64_stack.sh

ARG ARM
ARG COMMIT=unknown
ENV MERIT_ARM=${ARM} MERIT_IMAGE_COMMIT=${COMMIT}
RUN test "$ARM" = m8 -o "$ARM" = m27 || { echo "build with --build-arg ARM=m8 or ARM=m27" >&2; exit 1; }

# the x86 install (env/install_requirements.sh), with the arm64 wheel list in place of the x86 one
COPY baselines/merit/env/ /tmp/merit-env/
RUN cp /tmp/merit-env/wheels-$ARM-arm64.txt /tmp/merit-env/wheels-$ARM.txt \
    && MAX_JOBS=$MAX_JOBS NVCC_THREADS=1 bash /tmp/merit-env/install_requirements.sh "$ARM" python

# no GPU at build time: check versions by metadata, and that the pinned stack imports
RUN python -c "import importlib.metadata as md, torch, transformers, accelerate, sentence_transformers, decord, flash_attn; \
print('torch', torch.__version__, 'transformers', transformers.__version__, 'flash-attn', md.version('flash_attn')); \
assert torch.__version__.startswith('2.8.0'); \
assert transformers.__version__ == {'m8': '4.57.3', 'm27': '5.8.0'}['$ARM'], transformers.__version__" \
    && if [ "$ARM" = m27 ]; then python -c "import causal_conv1d, fla"; fi

WORKDIR /repo
CMD ["/bin/bash"]
