+def get_api_key(env_name, filename):
+    """EPIC-Morph port: the key from the environment, else upstream's key file; a provider this arm never
+    calls may have neither (its client is then built with a placeholder and fails if it is ever called)."""
+    if os.environ.get(env_name):
+        return os.environ[env_name]
+    return get_file_contents(filename) if os.path.exists(filename) else "MISSING"
+
+GOOGLE_GENAI_API_KEY = get_api_key("GOOGLE_API_KEY", GOOGLE_GENAI_KEY_PATH)
+OPENAI_API_KEY = get_api_key("OPENAI_API_KEY", OPENAI_API_KEY_PATH)
 
