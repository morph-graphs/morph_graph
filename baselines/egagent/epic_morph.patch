+def get_api_key(*env_names):
+    """EPIC-Morph port: API keys come from the environment only, never from a key file. A provider this arm
+    never calls may have none: its client is then built with a placeholder and fails if it is ever called."""
+    for name in env_names:
+        if os.environ.get(name):
+            return os.environ[name]
+    return "MISSING"
+
+GOOGLE_GENAI_API_KEY = get_api_key("GEMINI_API_KEY", "GOOGLE_API_KEY")
+# EPIC-Morph port: GOOGLE_GEMINI_BASE_URL, which Google's genai SDK reads, points the Gemini calls at another
+# endpoint that speaks Google's API (default https://generativelanguage.googleapis.com); recorded with every call
+# EPIC-Morph port: with OPENROUTER_API_KEY set and no Gemini key, the Gemini calls go to OpenRouter's OpenAI-compatible
+# endpoint as google/<model>, pinned to Google AI Studio (Google's Gemini API) with no fallback, through LangChain's
+# OpenAI client: the same prompts, but not Google's client, so the structured outputs are asked the OpenAI way.
+GEMINI_OPENROUTER = bool(os.environ.get("OPENROUTER_API_KEY")) and GOOGLE_GENAI_API_KEY == "MISSING"
+GEMINI_CLIENT_OPTIONS = {"api_endpoint": os.environ["GOOGLE_GEMINI_BASE_URL"].rstrip("/")} if os.environ.get("GOOGLE_GEMINI_BASE_URL") else None
+# EPIC-Morph port, the gateway for the GPT calls: with OPENROUTER_API_KEY set and OPENAI_API_KEY not, the same
+# Chat Completions requests go to OpenRouter as openai/<model>, pinned to the provider OpenAI with no fallback
+# (OpenAI itself answers, or the call fails). With OPENAI_API_KEY set they go to OpenAI, as released, or to the
+# OpenAI-compatible gateway in OPENAI_BASE_URL when that is set (the endpoint is recorded with every call).
+OPENROUTER = bool(os.environ.get("OPENROUTER_API_KEY")) and not os.environ.get("OPENAI_API_KEY")
+OPENAI_API_KEY = get_api_key("OPENROUTER_API_KEY" if OPENROUTER else "OPENAI_API_KEY")
+OPENROUTER_BASE_URL = os.environ.get("OPENROUTER_BASE_URL") or "https://openrouter.ai/api/v1"
+OPENAI_BASE_URL = OPENROUTER_BASE_URL if OPENROUTER else os.environ.get("OPENAI_BASE_URL") or "https://api.openai.com/v1"
+OPENAI_MODEL_PREFIX = "openai/" if OPENROUTER else os.environ.get("EGAGENT_GPT_PREFIX", "")   # e.g. azure/openai/ on a gateway
+OPENAI_EXTRA_BODY = {"provider": {"only": ["openai"], "allow_fallbacks": False}} if OPENROUTER else None
 
